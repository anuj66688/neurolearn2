# NeuroLearn Environment Variables Example
# Do not commit real keys or credentials to version control.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=neurolearn-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neurolearn-project
VITE_FIREBASE_STORAGE_BUCKET=neurolearn-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AI Service Configuration (Server-side or Client dev proxy)
# In production, LLM calls are routed through the secure backend AI service.
VITE_AI_PROVIDER=gemini
VITE_AI_FALLBACK_MODE=true
# SERVER_SIDE_AI_KEY=your_secure_server_key_do_not_prefix_with_vite
